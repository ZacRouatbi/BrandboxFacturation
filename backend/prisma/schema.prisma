// ================= ENUMS =================

enum TierRole {
  CLIENT
  FOURNISSEUR
  BOTH
}

enum DocumentType {
  DEVIS
  FACTURE
}

enum DevisStatus {
  ON_HOLD
  ACCEPTED
  CANCELLED
}

enum FactureStatus {
  NOT_PAID
  PAID
}

enum Currency {
  EUR
  TND 
  USD
}

// ================= MODELS =================
model User {
  id                String    @id @default(uuid())
  username          String    @unique
  password          String
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Tier {
  id        String   @id @db.VarChar(50)
  name      String
  mf        String?
  phone     String?
  address   String?
  role      TierRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  
}

model TierSequence {
  id        String   @id @default(uuid())
  prefix    String
  month     Int
  year      Int
  counter   Int      @default(0)

  @@unique([prefix, month, year])
}

model Document {
  id            String   @id @db.VarChar(50)
  type          DocumentType

  // Conditional statuses
  devisStatus   DevisStatus?
  factureStatus FactureStatus?

  date          DateTime @default(now())
  dueDate       DateTime?

  totalHT       Decimal  @db.Decimal(15, 3)
  totalTTC      Decimal  @db.Decimal(15, 3)
  currency      Currency
  tva           Decimal  @db.Decimal(5,2)

  tierId        String
  tier   Tier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  designations  Designation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([type])
  @@index([type, devisStatus])
  @@index([type, factureStatus])
  @@index([date])
  }

model DocumentSequence {
  id      Int    @id @default(autoincrement())
  prefix  String
  month   Int?
  year    Int
  counter Int

  @@unique([prefix, month, year], name: "prefix_month_year")
  @@unique([prefix, year], name: "prefix_year")
}

model Designation {
  id          String   @id @db.VarChar(50)

  description String

  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(15, 3)
  total       Decimal  @db.Decimal(15, 3)

  documentId  String   @db.VarChar(50)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model DesignationSequence {
  id      Int @id @default(autoincrement())
  month   Int
  year    Int
  counter Int

  @@unique([month, year])
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
